#version 450
// each invocation stores its position as a color into the storage image
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0, rgba8) uniform writeonly image2D target;
void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    imageStore(target, p, vec4(float(p.x) / 15.0, float(p.y) / 15.0, 0.5, 1.0));
}
