#version 450
// each invocation writes index * 2 + base into the storage buffer
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) buffer Out { uint values[]; } out_buffer;
layout(push_constant) uniform Push { uint base; } pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    out_buffer.values[i] = i * 2u + pc.base;
}
